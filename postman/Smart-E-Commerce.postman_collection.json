{"info":{"name":"Smart E-Commerce API","description":"Variable-driven collection for FastAPI and Django. No real credentials or secrets are included.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[
{"name":"Authentication","item":[
{"name":"Login customer","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{customer_email}}\",\"password\":\"{{customer_password}}\"}"},"url":"{{api_base_url}}/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200 OK', () => pm.response.to.have.status(200));","const body=pm.response.json(); if(body.access_token) pm.environment.set('customer_token',body.access_token); if(body.refresh_token) pm.environment.set('refresh_token',body.refresh_token);"]}}]},
{"name":"Refresh token","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"refresh_token\":\"{{refresh_token}}\"}"},"url":"{{api_base_url}}/auth/refresh"}},
{"name":"Current user","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{customer_token}}"}],"url":"{{api_base_url}}/auth/me"}},
{"name":"Auth0 exchange","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{auth0_access_token}}"}],"url":"{{api_base_url}}/auth/auth0/login"}}]},
{"name":"Products","item":[
{"name":"List products","request":{"method":"GET","url":"{{api_base_url}}/products?category={{category}}&in_stock={{in_stock}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200 OK', () => pm.response.to.have.status(200));","const body=pm.response.json(); if(body.length) pm.environment.set('product_id',body[0].id);"]}}]},
{"name":"Get product","request":{"method":"GET","url":"{{api_base_url}}/products/{{product_id}}"}},
{"name":"Create product (admin)","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Postman Product\",\"category\":\"general\",\"price\":100.00,\"stock\":10,\"images\":[]}"},"url":"{{api_base_url}}/products"}},
{"name":"Update product (staff/admin)","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{staff_token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"stock\":12}"},"url":"{{api_base_url}}/products/{{product_id}}"}},
{"name":"Deactivate product (admin)","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"}],"url":"{{api_base_url}}/products/{{product_id}}"}}]},
{"name":"Cart","item":[
{"name":"Get cart","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{customer_token}}"}],"url":"{{api_base_url}}/cart"}},
{"name":"Add item","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{customer_token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"product_id\":\"{{product_id}}\",\"quantity\":1}"},"url":"{{api_base_url}}/cart/add"}},
{"name":"Update item","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{customer_token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"product_id\":\"{{product_id}}\",\"quantity\":2}"},"url":"{{api_base_url}}/cart/update"}},
{"name":"Remove item","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{customer_token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"product_id\":\"{{product_id}}\"}"},"url":"{{api_base_url}}/cart/remove"}}]},
{"name":"Checkout, orders and payments","item":[
{"name":"Create Stripe checkout","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{customer_token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"payment_method\":\"stripe\",\"currency\":\"usd\"}"},"url":"{{api_base_url}}/checkout"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('201 Created', () => pm.response.to.have.status(201));","const body=pm.response.json(); if(body.order) pm.environment.set('order_id',body.order.id);"]}}]},
{"name":"My orders","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{customer_token}}"}],"url":"{{api_base_url}}/orders/me"}},
{"name":"List orders (staff/admin)","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{staff_token}}"}],"url":"{{api_base_url}}/orders"}},
{"name":"Update order status (staff/admin)","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{staff_token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"shipped\"}"},"url":"{{api_base_url}}/orders/{{order_id}}/status"}},
{"name":"Get payment","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{customer_token}}"}],"url":"{{api_base_url}}/payments/{{order_id}}"}},
{"name":"List payments (staff/admin)","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{staff_token}}"}],"url":"{{api_base_url}}/payments"}},
{"name":"Stripe webhook (requires valid signature)","request":{"method":"POST","header":[{"key":"Stripe-Signature","value":"{{stripe_signature}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{}"},"url":"{{api_base_url}}/webhooks/stripe"}}]},
{"name":"RBAC and notifications","item":[{"name":"Admin role check","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"}],"url":"{{api_base_url}}/rbac/admin"}},{"name":"Staff role check","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{staff_token}}"}],"url":"{{api_base_url}}/rbac/staff"}},{"name":"Notifications","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{customer_token}}"}],"url":"{{api_base_url}}/notifications?page=1&page_size=50"}}]},
{"name":"Django analytics and reports (Django session login required)","item":[{"name":"Analytics","request":{"method":"GET","url":"{{django_base_url}}/dashboard/?period=30d"}},{"name":"Reports page","request":{"method":"GET","url":"{{django_base_url}}/dashboard/reports/?period=30d"}},{"name":"Orders CSV","request":{"method":"GET","url":"{{django_base_url}}/dashboard/reports/orders/csv/?period=30d"}},{"name":"Orders PDF","request":{"method":"GET","url":"{{django_base_url}}/dashboard/reports/orders/pdf/?period=30d"}},{"name":"Sales CSV","request":{"method":"GET","url":"{{django_base_url}}/dashboard/reports/sales/csv/?period=30d"}},{"name":"Sales PDF","request":{"method":"GET","url":"{{django_base_url}}/dashboard/reports/sales/pdf/?period=30d"}},{"name":"Users CSV","request":{"method":"GET","url":"{{django_base_url}}/dashboard/reports/users/csv/?period=30d"}},{"name":"Users PDF","request":{"method":"GET","url":"{{django_base_url}}/dashboard/reports/users/pdf/?period=30d"}}]}
]}
