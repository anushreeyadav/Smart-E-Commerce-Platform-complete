          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.access_token) { pm.environment.set('accessToken', data.access_token); }",
              "if (data.refresh_token) { pm.environment.set('refreshToken', data.refresh_token); }"
            ]
          }
        }
      ]
    },
